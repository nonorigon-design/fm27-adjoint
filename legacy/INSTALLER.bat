@echo off
setlocal
powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -Command "$ErrorActionPreference='Stop'; [Net.ServicePointManager]::SecurityProtocol=[Net.SecurityProtocolType]::Tls12; $stage=Join-Path $env:TEMP ('fm27-'+[guid]::NewGuid()); try { New-Item -ItemType Directory -Path $stage | Out-Null; Write-Host 'Telechargement de FM27 Adjoint...'; $zip=Join-Path $stage 'app.zip'; Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/nonorigon-design/fm27-adjoint/archive/refs/heads/main.zip' -OutFile $zip; Expand-Archive -LiteralPath $zip -DestinationPath $stage; $source=Join-Path $stage 'fm27-adjoint-main'; $dest=Join-Path $env:LOCALAPPDATA 'FM27_Adjoint\programme'; New-Item -ItemType Directory -Force -Path $dest | Out-Null; Copy-Item -Path (Join-Path $source '*') -Destination $dest -Recurse -Force; Remove-Item -LiteralPath $stage -Recurse -Force; & (Join-Path $dest 'launcher.ps1'); exit $LASTEXITCODE } catch { Write-Host $_.Exception.Message -ForegroundColor Red; Read-Host 'Appuie sur Entree'; exit 1 }"
if errorlevel 1 pause
